# テプラ SPC10 自動印刷設定
# このファイルを .env にコピーして値を設定してください

# SPC10.exe のフルパス
TEPRA_SPC10_PATH=C:\Program Files (x86)\KING JIM\TEPRA Label Editor SPC10\SPC10.exe

# 使用する .lw1 テンプレートファイルのフルパス（例: 12mm テープ用）
TEPRA_LW1_PATH=C:\Users\infolab\Documents\12mm.lw1

# SPC10 の一時出力フォルダ（省略時は labels/temp を自動作成）
# TEPRA_TEMP_DIR=C:\Users\infolab\Documents\tepra_temp

# 印刷枚数（デフォルト: 1）
# TEPRA_COPIES=1